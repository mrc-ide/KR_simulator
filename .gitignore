__pycache__/
*.py[cod]

# Local Claude Code session logs (detailed convo history, not shared)
.claude/sessions/

# Python packaging build artefacts
*.egg-info/
build/
dist/

# Virtual environment
.venv/

# Regenerated on every test run (compared against tests/baseline/)
tests/output/

# Files the notebooks write when they are run
notebooks/output/
.ipynb_checkpoints/

# Website build output (Quarto)
docs/_site/
docs/.quarto/

# Default output folder if krsim is run inside the repo
output/

# Written when slurm/krsim_array.sh is run
slurm/results/
slurm/logs/
